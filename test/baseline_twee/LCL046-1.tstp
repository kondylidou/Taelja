% SZS status Unsatisfiable

% SZS output start CNFRefutation
cnf(c1, negated_conjecture, ~is_a_theorem(implies(a, a)), file('LCL046-1.p', prove_cn_16)).
cnf(c2, axiom, is_a_theorem(implies(X, implies(not(X), Y))), file('LCL046-1.p', cn_3)).
cnf(c3, axiom, is_a_theorem(implies(implies(X2, Y2), implies(implies(Y2, Z), implies(X2, Z)))), file('LCL046-1.p', cn_1)).
cnf(c4, axiom, ~is_a_theorem(implies(X2, Y2)) | ~is_a_theorem(X2) | is_a_theorem(Y2), file('LCL046-1.p', condensed_detachment)).
cnf(c5, plain, ~is_a_theorem(implies(a, implies(not(a), a))) | is_a_theorem(implies(implies(implies(not(a), a), a), implies(a, a))), inference(resolution, [status(thm)], [c3, c4])).
cnf(c6, plain, is_a_theorem(implies(implies(implies(not(a), a), a), implies(a, a))), inference(resolution, [status(thm)], [c2, c5])).
cnf(c7, axiom, is_a_theorem(implies(implies(not(X2), X2), X2)), file('LCL046-1.p', cn_2)).
cnf(c8, plain, ~is_a_theorem(implies(implies(implies(not(a), a), a), implies(a, a))) | is_a_theorem(implies(a, a)), inference(resolution, [status(thm)], [c7, c4])).
cnf(c9, plain, is_a_theorem(implies(a, a)), inference(resolution, [status(thm)], [c6, c8])).
cnf(c10, plain, $false, inference(proved_conjecture, [status(thm)], [c1, c9])).
% SZS output end CNFRefutation

