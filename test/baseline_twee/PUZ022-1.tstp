cnf(c1, negated_conjecture, ~state(State1) | ~state(State2) | ~borders(State1, State2) | ~borders(State1, Ocean) | ~borders(State2, Ocean) | ~ocean(Ocean), file('PUZ022-1.p', prove_borders)).
cnf(c2, negated_conjecture, state(western_australia), file('PUZ022-1.p', western_australia)).
cnf(c3, negated_conjecture, state(northern_territory), file('PUZ022-1.p', northern_territory)).
