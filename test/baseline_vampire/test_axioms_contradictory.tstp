% The refutation closes from the axioms alone and never resolves the negated
% conjecture: the axioms are contradictory, so the conjecture holds vacuously.
fof(f1,axiom,(
  p(a)),
  file('test_axioms_contradictory.p',f1)).
fof(f2,axiom,(
  ~p(a)),
  file('test_axioms_contradictory.p',f2)).
fof(f3,conjecture,(
  q(b)),
  file('test_axioms_contradictory.p',f3)).
fof(f4,negated_conjecture,(
  ~q(b)),
  inference(negated_conjecture,[status(cth)],[f3])).
cnf(c1,plain,(
  p(a)),
  inference(cnf_transformation,[status(esa)],[f1])).
cnf(c2,plain,(
  ~p(a)),
  inference(cnf_transformation,[status(esa)],[f2])).
cnf(c3,plain,(
  $false),
  inference(resolution,[status(thm)],[c1,c2])).
