      _ = times (sK0 sK2) x := by have h_rw := (taelja_lemma27 hyp3); rw [h_rw]

-- Lemma 29
theorem taelja_lemma29 : (sK3 = (times sK1 sK2)) → (element sK1) → (element sK2) → (times (times sK1 sK2) (times (times sK1 sK2) (times sK1 sK2))) = (times sK1 sK2) := by
  intro hyp1 hyp2 hyp3
  calc times (times sK1 sK2) (times (times sK1 sK2) (times sK1 sK2)) = times (times sK1 sK2) (times (times sK1 sK2) sK3) := by have h_rw := hyp1; rw [h_rw]
      _ = times sK1 (times sK2 (times (times sK1 sK2) (times sK1 sK2))) := by have h_rw := (taelja_lemma9 hyp1) (times sK1 sK2) (times sK1 sK2); rw [h_rw]
      _ = times sK1 (times sK2 (times sK3 (times sK1 sK2))) := by have h_rw := hyp1; rw [h_rw]
      _ = times sK1 (times sK2 (times sK2 (times (times sK1 sK2) sK1))) := by have h_rw := (taelja_lemma10 hyp1) (times sK1 sK2); rw [h_rw]
      _ = times sK1 (times sK2 (times sK1 (times (sK0 sK1) (times sK2 (times sK1 sK2))))) := by have h_rw := (taelja_lemma22 hyp2) sK2 (times sK1 sK2); rw [h_rw]
      _ = times sK1 (times sK2 (times sK1 (times (sK0 sK1) (times (sK0 sK2) sK1)))) := by have h_rw := (taelja_lemma28 hyp3) sK1; rw [h_rw]
      _ = times sK1 (times sK2 (times (sK0 sK2) (times sK1 sK1))) := by have h_rw := (taelja_lemma22 hyp2) (sK0 sK2) sK1; rw [h_rw]
      _ = times sK1 (times sK2 (times (sK0 sK2) (sK0 sK1))) := by have h_rw := (taelja_lemma8 hyp2); rw [h_rw]
      _ = times (sK0 sK2) (times (sK0 sK1) sK3) := by have h_rw := (taelja_lemma9 hyp1) (sK0 sK2) (sK0 sK1); rw [h_rw]
      _ = times (sK0 sK2) (times sK1 (times sK3 sK1)) := by have h_rw := (taelja_lemma20 hyp2) sK3; rw [h_rw]
      _ = times (sK0 sK2) (times sK1 (times sK2 (sK0 sK1))) := by have h_rw := (taelja_lemma26 hyp1 hyp2); rw [h_rw]
      _ = times (sK0 sK2) (times sK1 sK2) := by have h_rw := (taelja_lemma7 hyp2) sK2; rw [h_rw]
      _ = times sK2 (times sK1 (sK0 sK2)) := by have h_rw := (taelja_lemma14 hyp2) (sK0 sK2) sK2; rw [h_rw]
      _ = times sK2 (times sK1 (times (sK0 sK2) (sK0 sK1))) := by have h_rw := (taelja_lemma7 hyp2) (sK0 sK2); rw [h_rw]
      _ = times sK2 (times sK1 (times (sK0 sK2) (times sK1 sK1))) := by have h_rw := (taelja_lemma8 hyp2); rw [h_rw]
      _ = times sK2 (times sK1 (times sK1 (times sK1 (sK0 sK2)))) := by have h_rw := (taelja_lemma14 hyp2) sK1 (sK0 sK2); rw [h_rw]
      _ = times sK2 (times (times sK1 (sK0 sK2)) (times sK1 sK1)) := by have h_rw := (taelja_lemma14 hyp2) (times sK1 (sK0 sK2)) sK1; rw [h_rw]
      _ = times sK2 (times (times sK1 (sK0 sK2)) (sK0 sK1)) := by have h_rw := (taelja_lemma8 hyp2); rw [h_rw]
      _ = times sK1 (times sK1 (times sK2 (times sK1 (sK0 sK2)))) := by have h_rw := (taelja_lemma24 hyp2) sK2 (times sK1 (sK0 sK2)); rw [h_rw]
      _ = times sK1 (times sK1 (times (sK0 sK2) (times sK1 sK2))) := by have h_rw := (taelja_lemma14 hyp2) (sK0 sK2) sK2; rw [h_rw]
      _ = times (sK0 sK2) (times (times sK1 sK2) (sK0 sK1)) := by have h_rw := (taelja_lemma24 hyp2) (sK0 sK2) (times sK1 sK2); rw [h_rw]
      _ = times (sK0 sK2) (times sK2 (times (sK0 sK1) sK1)) := by have h_rw := ax3 sK1 sK2 (sK0 sK1); rw [h_rw]
      _ = times (sK0 sK2) (times sK2 sK1) := by have h_rw := (taelja_lemma17 hyp2); rw (config := { occs := .pos [3] }) [h_rw]
      _ = times (sK0 sK2) (times sK2 (times sK1 (sK0 sK1))) := by have h_rw := (taelja_lemma11 hyp2); rw (config := { occs := .pos [1] }) [h_rw]
      _ = times (sK0 sK2) (times (sK0 sK1) (times sK1 sK2)) := by have h_rw := (taelja_lemma14 hyp2) sK2 (sK0 sK1); rw [h_rw]
      _ = times (sK0 sK2) (times (times sK2 (sK0 sK1)) sK1) := by have h_rw := ax3 sK2 (sK0 sK1) sK1; rw [h_rw]
      _ = times (times sK1 (sK0 sK2)) (times sK2 (sK0 sK1)) := by have h_rw := ax3 sK1 (sK0 sK2) (times sK2 (sK0 sK1)); rw [h_rw]
      _ = times (times (sK0 sK1) (times sK1 (sK0 sK2))) sK2 := by have h_rw := ax3 (sK0 sK1) (times sK1 (sK0 sK2)) sK2; rw [h_rw]
      _ = times (times (sK0 sK2) (times sK1 (sK0 sK1))) sK2 := by have h_rw := (taelja_lemma14 hyp2) (sK0 sK2) (sK0 sK1); rw [h_rw]
      _ = times (times (sK0 sK2) sK1) sK2 := by have h_rw := (taelja_lemma11 hyp2); rw (config := { occs := .pos [3] }) [h_rw]
      _ = times sK1 (times sK2 (sK0 sK2)) := by have h_rw := ax3 (sK0 sK2) sK1 sK2; rw [h_rw]
      _ = times sK1 sK2 := by have h_rw := (taelja_lemma18 hyp3); rw (config := { occs := .pos [3] }) [h_rw]

-- Goal 1
theorem taelja_goal1 : (sK3 = (times sK1 sK2)) → (element sK1) → (element sK2) → element sK3 := by
  intro hyp1 hyp2 hyp3
  have h1 : (times (times sK1 sK2) (times (times sK1 sK2) (times sK1 sK2))) = (times sK1 sK2) := by first | (exact (taelja_lemma29 hyp1 hyp2 hyp3)) | (first | apply (taelja_lemma29 hyp1 hyp2 hyp3) <;> first | rfl | assumption | (apply Eq.symm; apply (taelja_lemma29 hyp1 hyp2 hyp3) <;> first | rfl | assumption))
  have h2 : element (times sK1 sK2) := by first | (exact ax4 _ _ h1) | (apply ax4 <;> (first | assumption | rfl | exact Eq.symm (by assumption) | exact Eq.trans (by assumption) (by assumption) | exact Eq.trans (Eq.symm (by assumption)) (by assumption) | exact Eq.trans (by assumption) (Eq.symm (by assumption)) | exact Eq.trans (Eq.symm (by assumption)) (Eq.symm (by assumption)) | exact taelja_elem))
  have h3 : element sK3 := by have h_rw := hyp1; rw [h_rw]; exact h2
  exact h3

