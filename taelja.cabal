cabal-version: 3.0
name:          taelja
version:       0.2.0.1
synopsis:      A tool that translates refutation proofs to a readable (pretty) proof format for the Horn clause fragment
license:       GPL-3.0-or-later
license-file:  LICENSE
copyright:     2026 Lydia Kondylidou
author:        Lydia Kondylidou

common warnings
  ghc-options: -Wall

library
  import:           warnings
  hs-source-dirs:   src
  exposed-modules:
    Types
    Helpers
    Emitter
    TptpEmitter
    LeanEmitter
    ProofTree
    Conjecture
    HornProblem
    PropRes
    TptpConvert
    StepReader
    LemmaBuilder
    Theta
    Translate
    Debug
  build-depends:
    base        >=4.18 && <4.22,
    attoparsec  ^>=0.14,
    containers  >=0.6 && <0.8,
    deepseq     >=1.4 && <1.6,
    directory   >=1.3,
    filepath,
    mtl         ^>=2.3,
    process     ^>=1.6,
    text        >=2.0 && <2.2,
    tptp        ^>=0.1,
    prettyprinter >=1.7 && <1.8
  default-language: GHC2021

test-suite taelja-tests
  import:           warnings
  type:             exitcode-stdio-1.0
  main-is:          Main.hs
  hs-source-dirs:   test
  build-depends:
    base          >=4.18 && <4.22,
    bytestring    >=0.11 && <0.13,
    containers    >=0.6 && <0.8,
    deepseq       >=1.4 && <1.6,
    text          >=2.0 && <2.2,
    attoparsec    ^>=0.14,
    tptp          ^>=0.1,
    tasty         >=1.4,
    tasty-golden  >=2.3.6,
    process       >=1.6,
    taelja
  build-tool-depends: taelja:taelja
  default-language: GHC2021

executable taelja
  import:         warnings
  main-is:        Main.hs
  hs-source-dirs: app
  build-depends:
    base        >=4.18 && <4.22,
    deepseq     >=1.4 && <1.6,
    text        >=2.0 && <2.2,
    attoparsec  ^>=0.14,
    tptp        ^>=0.1,
    taelja
  default-language: GHC2021
